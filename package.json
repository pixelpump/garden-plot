{
  "name": "garden-plot",
  "private": true,
  "version": "0.2.0",
  "description": "A daily tree-planting logic puzzle for Shepherd crews.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:server": "vite build --config vite.server.config.ts",
    "export:shepherd": "bash scripts/export-to-shepherd.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  }
}
